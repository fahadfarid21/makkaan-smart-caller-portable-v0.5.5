{
  "manifest_version": 3,
  "name": "Makkaan Sales Sidecar",
  "version": "0.6.0",
  "description": "Local-first Makkaan sales desk with lead queue, pre-call briefs, editable calculator, guided human-confirmed CRM updates, Investor Mode, and a daily KPI coach. AI note refinement requires user configuration. No auto-dialing or unsupervised CRM writes.",
  "permissions": [
    "activeTab",
    "storage",
    "sidePanel",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://prop-360.com/app/lead/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Open Makkaan Sales Sidecar",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://prop-360.com/app/lead/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
